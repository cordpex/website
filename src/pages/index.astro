---
import '../styles/brand.css';

const year = new Date().getFullYear();
const description =
  'La primera plataforma White Label de cobros recurrentes y suscripciones de Venezuela.';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Cordpex</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://cordpex.com/" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Cordpex" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://cordpex.com/" />
    <meta property="og:locale" content="es_VE" />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#f5f2eb" />

    <!-- The display face renders the headline, so load it ahead of first paint. -->
    <link
      rel="preload"
      href="/fonts/Utendo-Bold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>

  <body>
    <main>
      <img class="logo" src="/cordpex-lockup.svg" alt="Cordpex" width="352" height="217" />

      <p class="eyebrow">Próximamente</p>

      <h1>Cobros recurrentes y suscripciones, hechos para Venezuela</h1>

      <p class="lead">
        La primera plataforma White Label de cobros automatizados del país.
        Permitimos que cualquier empresa ofrezca mensualidades y membresías a
        sus clientes, sin construir infraestructura propia.
      </p>
    </main>

    <footer>&copy; {year} Cordpex</footer>
  </body>
</html>

<style>
  * {
    box-sizing: border-box;
  }

  html,
  body {
    height: 100%;
  }

  body {
    margin: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 3rem;
    padding: 3rem 1.5rem 2rem;
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-body);
    -webkit-font-smoothing: antialiased;
    text-wrap: pretty;
  }

  main {
    width: 100%;
    max-width: 38rem;
    text-align: center;
  }

  .logo {
    width: clamp(9rem, 26vw, 11.5rem);
    height: auto;
    margin: 0 auto;
    display: block;
  }

  .eyebrow {
    margin: 2.5rem 0 0;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
  }

  h1 {
    margin: 1rem 0 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.85rem, 6vw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .lead {
    margin: 1.5rem auto 0;
    max-width: 32rem;
    font-size: clamp(1rem, 2.4vw, 1.125rem);
    line-height: 1.65;
    color: var(--text-muted);
  }

  footer {
    font-size: 0.8rem;
    color: var(--text-muted);
  }
</style>
